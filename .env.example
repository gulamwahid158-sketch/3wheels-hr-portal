# Copy to .env and fill in. Loaded automatically by backend/db.py (real env vars win).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=peopledesk
MYSQL_PASSWORD=change-me
MYSQL_DB=peopledesk

# Flask session signing key — set to a long random string in any real deployment
SECRET_KEY=dev-only-change-me

# Optional: outgoing email for welcome / payslip mails
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=hr@3wheels.ai
